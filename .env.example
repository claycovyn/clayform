# Secret used to sign login sessions. Required in production.
# Generate one with: openssl rand -hex 32
CLAYFORM_SECRET=

# "closed" stops new sign-ups (useful for a private install once your account exists).
CLAYFORM_SIGNUPS=open

# Set to 1 to allow webhooks to private network addresses (off by default for safety).
# CLAYFORM_ALLOW_PRIVATE_WEBHOOKS=1

# Postgres connection string. When set, Clayform uses Postgres instead of SQLite.
# Required on Vercel (Storage → Create Database → Neon adds it for you).
# DATABASE_URL=postgres://user:password@host:5432/clayform

# Where the SQLite database and uploaded files live (SQLite only). Default: ./data
CLAYFORM_DATA_DIR=./data

# Public URL of this install, used in share links and embed code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Max upload size for file-upload questions, in megabytes. Default: 10 (4 on Vercel)
CLAYFORM_MAX_UPLOAD_MB=10

# Link to this install's source code (shown on the home page and at /source). If you run a modified Clayform for
# other people, the AGPL-3.0 asks you to offer them your source: point this at your fork.
# CLAYFORM_SOURCE_URL=https://github.com/you/clayform

# OPENCTRL Cloud (the hosted clayform.vercel.app). Leave unset when self-hosting: no plans, no limits.
# 1 = enforce plan limits (Free Cloud: 100 completed responses a month), show "Report" on public forms, and refuse
# publishing forms that collect credentials. Accounts created before this was turned on keep no limits.
# CLAYFORM_CLOUD=1

# Emails allowed to open /admin (usage, cost to serve, reports, takedowns). Comma-separated.
# CLAYFORM_ADMIN_EMAILS=you@example.com

# Shown to owners whose form was taken down, so they can appeal.
# CLAYFORM_SUPPORT_EMAIL=support@example.com

# Email (Resend) for verification and usage notices on the hosted Cloud. Without a key nothing is sent.
# RESEND_API_KEY=re_...
# CLAYFORM_EMAIL_FROM=Clayform <hello@yourdomain.com>
# Where "Upgrade" links point once OPENCTRL billing is live.
# OPENCTRL_CLOUD_URL=https://openctrl.example/cloud
