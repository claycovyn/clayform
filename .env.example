# Password for the Clayform dashboard. Required in production.
CLAYFORM_PASSWORD=change-me

# Secret used to sign the dashboard session cookie and resume links.
# Generate one with: openssl rand -hex 32
CLAYFORM_SECRET=

# Postgres connection string. When set, Clayform uses Postgres instead of SQLite.
# Required on Vercel (Storage → Create Database → Neon adds it for you).
# DATABASE_URL=postgres://user:password@host:5432/clayform

# Where the SQLite database and uploaded files live (SQLite only). Default: ./data
CLAYFORM_DATA_DIR=./data

# Public URL of this install, used in share links and embed code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Max upload size for file-upload questions, in megabytes. Default: 10 (4 on Vercel)
CLAYFORM_MAX_UPLOAD_MB=10
